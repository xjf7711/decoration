{
  "name": "deooration-3d",
  "version": "1.0.0",
  "description": "typescript start . ",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "yarn build && gh-pages -d dist",
    "postinstall": "node -e \"try{require('fs').rmSync('node_modules/sass-embedded',{recursive:true,force:true})}catch(e){}\"",
    "shift": "jscodeshift -t transform.js foo.js",
    "test": "jest",
    "lint": "eslint src",
    "lint-fix": "eslint 'src/**/*.{ts,js,tsx,jsx}' --fix -o eslint_log.log",
    "uml": "tsuml2 --glob ./src/**/*.ts",
    "docs": "typedoc --entryPointStrategy expand ./src",
    "coverage": "typescript-coverage-report"
  },
  "keywords": [
    "typescript",
    "vite"
  ],
  "author": "Xu",
  "license": "ISC",
  "devDependencies": {
    "@types/file-saver": "^2.0.3",
    "@types/jest": "^27.0.6",
    "@types/three": "^0.162.0",
    "@typescript-eslint/eslint-plugin": "^4.29.2",
    "@typescript-eslint/parser": "^4.29.2",
    "eslint": "^7.32.0",
    "gh-pages": "^6.1.1",
    "jest": "^27.0.6",
    "less": "^4.1.1",
    "sass": "^1.38.1",
    "terser": "^5.49.0",
    "ts-jest": "^27.0.5",
    "type-coverage": "^2.19.0",
    "typedoc": "^0.23.10",
    "typescript": "^4.7.4",
    "typescript-coverage-report": "^0.6.1",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@type-dom/framework": "*",
    "@type-dom/svgs": "*",
    "@type-dom/signals": "*",
    "@type-dom/ui": "*",
    "@type-dom/utils": "*",
    "axios": "^0.21.1",
    "file-saver": "^2.0.5",
    "jsbarcode": "^3.11.4",
    "jscodeshift": "^0.14.0",
    "jszip": "^3.7.1",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "three": "^0.162.0"
  },
  "typeCoverage": {
    "atLeast": 99,
    "is": 99,
    "cache": true,
    "debug": true,
    "detail": true,
    "ignoreCatch": true,
    "ignoreFiles": [
      "demo1/*.ts",
      "demo2/foo.ts"
    ],
    "project": "tsconfig.json",
    "strict": true,
    "suppressError": true,
    "update": true,
    "ignoreUnread": true,
    "ignoreNested": true,
    "ignoreAsAssertion": true,
    "ignoreTypeAssertion": true,
    "ignoreNonNullAssertion": true,
    "showRelativePath": true,
    "historyFile": "typecoverage.json",
    "noDetailWhenFailed": true
  }
}
